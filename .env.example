PORT=5000

# Local MySQL defaults. For a cloud database, use its host, port (e.g. 4000) and set DB_SSL=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce_db
DB_SSL=false

JWT_SECRET=replace_this_with_a_long_random_secret_string

# In production: your GitHub Pages address, e.g. https://kartikk2004.github.io
# Leave blank locally to allow any origin
FRONTEND_URL=